# Copy to .env.dev / .env.staging / .env.prod and fill in.
# NEVER commit the filled-in files — .gitignore already excludes .env.*

# ---- environment ----------------------------------------------------
ENVIRONMENT=dev            # dev | staging | prod
DEBUG=true                 # MUST be false in production
API_PORT=8000

# ---- database -------------------------------------------------------
# POSTGRES_HOST is "localhost" when the API runs on your machine and
# "postgres" when it runs inside docker (compose overrides it for you).
POSTGRES_USER=closet
POSTGRES_PASSWORD=<redacted>
POSTGRES_DB=closet_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_ECHO=false

# ---- security -------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=<redacted>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=<redacted>
REFRESH_TOKEN_DAYS=<redacted>
MFA_CHALLENGE_MINUTES=5

# ---- first-run administrator ---------------------------------------
# If BOTH are set and no administrator exists, one is created at startup.
# The account is flagged "must change password", so this value is a
# SINGLE-USE credential: the admin must replace it at first login before
# anything else works. Leave blank to create the admin with the CLI instead
# (scripts/manage_admin.py create).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrateur ClosET

# ---- accounts -------------------------------------------------------
PASSWORD_MIN_LENGTH=<redacted>
PASSWORD_RESET_HOURS=<redacted>
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
TOTP_ISSUER=ClosET
ADMIN_REQUIRES_2FA=true

# ---- misc -----------------------------------------------------------
CORS_ORIGINS=["*"]         # restrict to the admin/back-office origin in prod


# ---- media storage (S3-compatible: MinIO in dev, S3/R2 in prod) ----
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=closet-media
S3_PUBLIC_BASE_URL=http://localhost:9000/closet-media
S3_FORCE_PATH_STYLE=true
MEDIA_MAX_BYTES=5242880
MEDIA_ALLOWED_TYPES=["image/jpeg","image/png","image/webp"]


# ---- payments (CinetPay) --------------------------------------------
# Keep on "fake" until you have credentials AND have verified the flow.
# Switch to "cinetpay" and fill the CINETPAY_* values to go live.
PAYMENTS_ACTIVE_PROVIDER=fake
PAYMENTS_CURRENCY=XAF
PAYMENTS_RETURN_URL=closet://payment/return
CINETPAY_API_KEY=                 # <<< SET when live
CINETPAY_SITE_ID=                 # <<< SET when live
CINETPAY_SECRET=                  # <<< SET when live (webhook signature secret)
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
# Your PUBLIC webhook URL — uses your real onrender.com domain:
CINETPAY_NOTIFY_URL=https://<your-service-name>.onrender.com/api/v1/payments/webhook/cinetpay   # <<< SET
 
# ---- notifications --------------------------------------------------
# Empty = log to console (no messaging until you add a real provider).
# Render dashboard: set this as a plain string, e.g. {"whatsapp":"twilio"}
# --- Using Brevo (recommended free start) ---
NOTIFICATIONS_PROVIDERS={"email":"brevo"}
EMAIL_API_KEY=xkeysib-...your-brevo-key...
EMAIL_FROM_ADDRESS=noreply@yourdomain.cm
EMAIL_FROM_NAME=ClosET
# EMAIL_API_BASE_URL=            # leave unset in production
 
# --- To switch to Resend later, change ONLY these two lines: ---
# NOTIFICATIONS_PROVIDERS={"email":"resend"}
# EMAIL_API_KEY=re_...your-resend-key...
#   (EMAIL_FROM_ADDRESS / EMAIL_FROM_NAME stay the same)


# Seed Cameroon's geo reference data (regions / divisions / subdivisions
# / cities / neighbourhoods) on startup. Off by default; turn it on for
# the deployment where you want the database populated. Idempotent, so
# leaving it on is harmless once seeded.
SEED_GEO_ON_STARTUP=True